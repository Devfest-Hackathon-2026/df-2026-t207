{
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "hosting": {
    "public": "app/build/web",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      { "source": "**/*.@(js|wasm|json|otf|ttf|png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/flutter_service_worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "emulators": {
    "firestore": { "host": "127.0.0.1", "port": 8181 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
